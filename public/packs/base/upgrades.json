      "levels": [
        {
          "name": "Tiro certeiro",
          "description": "+30% dano em todos os disparos e -10% recarga.",
          "improvements": [
            { "type": "attr", "path": "shots[].damage", "op": "mul", "value": 1.30, "shotSelect": { "select": "all" } },
            { "type": "attr", "path": "cooldownMs", "op": "mul", "value": 0.90 }
          ]
        },
        {
          "name": "Chumbo grosso",
          "description": "+60% dano, -20% recarga e +1 perfuração nos projéteis.",
          "improvements": [
            { "type": "attr", "path": "shots[].damage", "op": "mul", "value": 1.60, "shotSelect": { "select": "all" } },
            { "type": "attr", "path": "cooldownMs", "op": "mul", "value": 0.80 },
            { "type": "attr", "path": "shots[].projectile.pierce", "op": "add", "value": 1, "shotSelect": { "select": "type", "shotType": "projectile" } }
          ]
        }
      ]
    },

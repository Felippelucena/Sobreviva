{
  "schemaVersion": 2,
  "defs": [
    {
      "kind": "upgrade",
      "id": "damage",
      "name": "Mais dano",
      "desc": "Aumenta o dano de todos os disparos da arma.",
      "scope": { "kind": "weapon" },
      "levels": [
        { "name": "Nível 1", "description": "+20% de dano", "improvements": [{ "type": "attr", "path": "shots[].damage", "op": "mul", "value": 1.20, "shotSelect": { "select": "all" } }] },
        { "name": "Nível 2", "description": "+44% de dano", "improvements": [{ "type": "attr", "path": "shots[].damage", "op": "mul", "value": 1.44, "shotSelect": { "select": "all" } }] },

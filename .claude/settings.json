{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "includeCoAuthoredBy": true,

  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run typecheck)",
      "Bash(npm run preview)",
      "Bash(npm test *)",
      "Bash(npm run test:watch)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git merge *)",
      "Bash(git rebase --continue)",
      "Bash(git remote -v)",
      "Bash(node *)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Read(./src/**)",
      "Read(./public/**)",
      "Read(./docs/**)",
      "Read(./.claude/**)",
      "Read(./.github/**)",
      "Read(./*.md)",
      "Read(./*.json)",
      "Read(./*.ts)",
      "Read(./*.html)",
      "Edit(./src/**)",
      "Edit(./public/packs/**)",
      "Edit(./docs/**)",
      "Edit(./.claude/agents/**)",
      "Edit(./.claude/skills/**)",
      "Edit(./.claude/rules/**)",
      "Edit(./.github/**)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:pixijs.com)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:vitejs.dev)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:typescriptlang.org)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(npm publish *)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./ROADMAP.md)",
      "Edit(./package.json)",
      "Edit(./tsconfig.json)",
      "Edit(./vite.config.ts)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  }
}
